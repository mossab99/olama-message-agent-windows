<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- Configure high DPI support for WinForms -->
    <AppContextSwitchOverrides value="Switch.System.Windows.Forms.UseNet50HighDpiSupport=true" />
  </runtime>
</configuration>
